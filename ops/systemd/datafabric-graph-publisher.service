[Unit]
Description=Data-Fabric graph publisher (Tang's group): publication_outbox events of the collection database into History
After=network.target
StartLimitIntervalSec=0

# What it does: publishes the pending outbox events and writes the publisher heartbeat (read graph/publish/publisher.py).
# Environment (runtime.env): DATAFABRIC_HISTORY_DATABASE_URL, DATAFABRIC_PUBLICATION_DATABASE_URL (the collection
# database) and the other DATAFABRIC_PUBLICATION_* settings. Fetching, cleaning and storing do not need it.
# Paths: WorkingDirectory and the python below are this host's checkout and venv; change both for another deployment.

[Service]
WorkingDirectory=%h/zk_projects/ZK_Data-Fabric-test
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/ZK_Data-Fabric-test/zk_env/bin/python -m graph.publish.publisher --poll-seconds 30 --batch-size 20
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
