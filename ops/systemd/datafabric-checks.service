[Unit]
Description=Data-Fabric extraction checks: does what Fabric extracted match the text it came from
After=network.target
StartLimitIntervalSec=0

# What it does: takes the tasks in derived_extraction_check_tasks (queued by the clean stage and the measurement
# worker), sends the products and their source text to the BioCheck service and writes derived_extraction_checks;
# for measurement readings it also writes the objects in derived_measurements (read db/extraction_checks.py).
# Environment (runtime.env): DATAFABRIC_HISTORY_DATABASE_URL (the history database), DATAFABRIC_BIOCHECK_URL and
# DATAFABRIC_BIOCHECK_TOKEN (without them the worker prints "disabled" and exits 0, so it stays stopped).

[Service]
WorkingDirectory=%h/zk_projects/ZK_Data-Fabric-test
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/ZK_Data-Fabric-test/zk_env/bin/python -m db.extraction_checks
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
