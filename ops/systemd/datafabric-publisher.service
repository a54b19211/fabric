[Unit]
Description=Data-Fabric committed source publisher
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/zk_projects/ZK_Data-Fabric-test
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/ZK_Data-Fabric-test/zk_env/bin/python -m flows.scheduler --poll-seconds 30 --batch-size 20 --backfill-batch-size 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
