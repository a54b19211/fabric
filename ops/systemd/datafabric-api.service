[Unit]
Description=Data-Fabric API (the fabric library's HTTP interface)
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/data/projects/fabric
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/fabric/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 18511
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
