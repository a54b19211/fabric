[Unit]
Description=Data-Fabric clean stage: clean text, identifiers and profiles of new versions
After=network.target
StartLimitIntervalSec=0

# What it does: claims blocks of new history_versions, writes derived_clean_text, derived_identifiers and
# derived_profiles, and in the same transaction queues the index and extraction-check work (read flows/clean_stage.py).
# Environment (runtime.env): DATAFABRIC_HISTORY_DATABASE_URL (the history database).
# Several copies may run at once: blocks are claimed with leases. Status: python -m flows.clean_stage --status

[Service]
WorkingDirectory=%h/zk_projects/ZK_Data-Fabric-test
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/zk_projects/ZK_Data-Fabric-test/zk_env/bin/python -m flows.clean_stage --loop --poll-seconds 60
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
