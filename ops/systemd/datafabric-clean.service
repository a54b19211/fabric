[Unit]
Description=Data-Fabric clean stage: clean text, identifiers, profiles and registry diffs of new versions
After=network.target
StartLimitIntervalSec=0

# What it does (read run/clean.py): takes batches of fabric_versions without a current profile, writes derived_clean_text,
# derived_identifiers, derived_profiles and the registry diffs, and in the same transaction queues the index work.
# Environment (runtime.env): DATAFABRIC_DATABASE_URL (the fabric database).
# Several copies may run at once: batches are claimed with SELECT ... FOR NO KEY UPDATE SKIP LOCKED.
# Paths: WorkingDirectory and the python below are this host's checkout and venv; change both for another deployment.
# Status: python -m run.clean --status

[Service]
WorkingDirectory=/data/projects/fabric
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/fabric/.venv/bin/python -m run.clean --loop --poll-seconds 60
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
