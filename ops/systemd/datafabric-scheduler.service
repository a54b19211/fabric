[Unit]
Description=Data-Fabric scheduler: due source watches become fetch runs on the extraction queue
After=network.target
StartLimitIntervalSec=0

# What it does: every round, each due watch (fetch/catalog.py WATCHES) takes one step (read run/scheduler.py).
# Environment (runtime.env): DATAFABRIC_DATABASE_URL, DATAFABRIC_REDIS_URL.
# Paths: WorkingDirectory and the python below are this host's checkout and venv; change both for another deployment.

[Service]
WorkingDirectory=/data/projects/fabric
EnvironmentFile=%h/.config/datafabric-publication/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/projects/fabric/.venv/bin/python -m run.scheduler --poll-seconds 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
