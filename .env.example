# ============================================================
# ZK_Data Fabric 环境变量配置模板
# 使用说明：复制本文件为 .env，填入真实密钥后即可运行
#   copy .env.example .env
# ============================================================

# ---- MinerU 云端 API（PDF 解析服务）----
MINERU_API_KEY=your_mineru_api_key_here
MINERU_API_BASE=https://mineru.net/api/v4

# ---- LLM API（OpenAI 兼容协议，支持 Qwen / DeepSeek / GPT / 本地 Ollama 等）----
# 用于实体抽取阶段（图谱节点/关系抽取），爬虫阶段不调用 LLM
# 爬虫只用 Trafilatura（规则提取）+ MinerU（PDF 解析），不消耗 token
LLM_API_KEY=dummy
LLM_API_BASE=http://100.121.201.73:60000/v1
LLM_MODEL_NAME=Qwen3.6-FP8

# 实体抽取专用模型（可选，留空则复用上面的 LLM_* 配置）
# 实体抽取对模型能力要求更高，建议使用更强的模型
EXTRACTION_LLM_API_KEY=
EXTRACTION_LLM_API_BASE=
EXTRACTION_LLM_MODEL_NAME=

# 消歧精排专用模型（可选，留空则复用上面的 LLM_* 配置）
# 精排是轻量判断任务，可用较小的模型降低成本
RERANK_LLM_API_KEY=
RERANK_LLM_API_BASE=
RERANK_LLM_MODEL_NAME=

# Embedding 模型（可选，留空则复用 LLM_API_KEY + 默认 Base/Model）
# 用于消歧向量检索，将实体名称转为向量
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024   # 默认 1024，不要改（需与 DB 向量维度一致）

# 常用配置示例：
#   Qwen:     LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL_NAME=qwen-plus
#   DeepSeek: LLM_API_BASE=https://api.deepseek.com/v1                        LLM_MODEL_NAME=deepseek-chat
#   GPT:      LLM_API_BASE=https://api.openai.com/v1                          LLM_MODEL_NAME=gpt-4o-mini
#   Ollama:   LLM_API_BASE=http://localhost:11434/v1                           LLM_MODEL_NAME=qwen2.5:7b  LLM_API_KEY=ollama

# ---- 数据存储根目录 ----
DATA_ROOT=data

# ---- 质量门控阈值 ----
MIN_MARKDOWN_LENGTH=100


# ---- 并发控制 ----
MAX_CONCURRENCY=3
TASK_RETRIES=3
TASK_RETRY_DELAY=10
EXTRACTION_CONCURRENCY=3        # LLM 抽取并行 Worker 数，建议 2-5（取决于 vLLM 显存）

# ---- WeKnora 同步配置 ----
# 文档 + 图数据同步到 WeKnora（上游知识库系统）
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=your_api_key_here
WEKNORA_KB_ID=your_kb_id_here

# ---- MinIO 预留（二期）----
FUTURE_MINIO_BUCKET=zk-data-fabric

# ---- 远程数据库（留空则不推送）----
# 支持 PostgreSQL（默认）或 MySQL（改用 mysql+pymysql://）
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5

# ---- 本地文件存储开关（开发/调试用，生产建议 False）----
ENABLE_LOCAL_STORAGE=False
