# ============================================================
# ZK_Data Fabric 环境变量配置模板
# 使用说明：复制本文件为 .env，填入真实密钥后即可运行
#   copy .env.example .env
# ============================================================

# ---- MinerU 云端 API（PDF 解析服务）----
DATAFABRIC_MINERU_CLOUD_TOKEN=your_mineru_cloud_token_here
DATAFABRIC_MINERU_MODE=cloud   # PDF/DOCX straight to MinerU cloud (no self-hosted MinerU)

# ---- 数据存储根目录 ----
DATA_ROOT=data

# ---- 并发控制 ----
MAX_CONCURRENCY=3
TASK_RETRIES=3
TASK_RETRY_DELAY=10

# ---- zk 文档库（只读：站点附件链接）----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=



# ---- 资料库服务（api、采集工人、派活程序、加工都读这些；部署照部署仓库 a54b19211/ZK-radar-deploy 整理）----
# 来源的可读 / 定时抓取开关不在这里：在库里（fabric_sources），经 /api/fabric/admin/sources 改
DATAFABRIC_DATABASE_URL=postgresql+psycopg2://用户:口令@主机:5432/zk_fabric
DATAFABRIC_REDIS_URL=redis://127.0.0.1:6379/1
DATAFABRIC_READ_TOKEN=
DATAFABRIC_ADMIN_TOKEN=
DATAFABRIC_FETCH_ENABLED=true
# 定时刷新计划写在 fetch/catalog.py · WATCHES；要这个实例不按它抓，写 DATAFABRIC_WATCHES=[]（给了就用环境变量的）
DATAFABRIC_RATE_DIR=
DATAFABRIC_PUBLICATION_DISK_PATH=.
DATAFABRIC_PUBLICATION_MIN_FREE_BYTES=16106127360
# 进 WeKnora 的目标（store/index_publication.py · targets）：[{"source_instance","source_id","is_demo","knowledge_base_id","source_scope","limit"(可选)}]
DATAFABRIC_INDEX_TARGETS=
