# ============================================================
# ZK_Data Fabric 环境变量配置模板
# 使用说明：复制本文件为 .env，填入真实密钥后即可运行
#   copy .env.example .env
# ============================================================

# ---- MinerU 云端 API（PDF 解析服务）----
MINERU_API_KEY=your_mineru_api_key_here
MINERU_API_BASE=https://mineru.net/api/v4

# ---- Qwen 通义千问 API（结构化信息提取）----
QWEN_API_KEY=your_qwen_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-plus

# ---- 数据存储根目录 ----
DATA_ROOT=/data

# ---- 质量门控阈值 ----
MIN_MARKDOWN_LENGTH=100
MIN_JSON_FILLED_RATIO=0.4

# ---- 并发控制 ----
MAX_CONCURRENCY=3
TASK_RETRIES=3
TASK_RETRY_DELAY=10

# ---- MinIO 预留（二期）----
FUTURE_MINIO_BUCKET=zk-data-fabric

